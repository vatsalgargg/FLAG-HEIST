{
  "name": "ctf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "services:up": "docker compose --profile images build && docker compose up -d",
    "services:down": "docker compose down",
    "api:dev": "npm run dev --prefix services/ctf/platform",
    "test:integration": "node scripts/verify-integration.mjs",
    "test:services": "npm run test:scoring --prefix services/ctf/platform && npm run test:admin --prefix services/ctf/platform",
    "db:migrate": "npm run db:migrate --prefix services/ctf/platform",
    "db:seed": "npm run db:seed --prefix services/ctf/platform",
    "test:restore": "node scripts/verify-restore.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
