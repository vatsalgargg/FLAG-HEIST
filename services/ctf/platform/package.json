{
  "name": "root-ctf-platform",
  "version": "0.1.0",
  "description": "Scoring and competition platform for ROOT CTF (Veyra Cloud Solutions)",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rimraf dist",
    "test": "tsx src/auth/verifyAuth.ts",
    "test:scoring": "tsx src/scoring/verifyScoring.ts",
    "test:admin": "tsx src/admin/verifyAdmin.ts",
    "test:batch1": "tsx src/scoring/verifyChallengesBatch1.ts",
    "test:batch2": "tsx src/scoring/verifyChallengesBatch2.ts",
    "test:batch3": "tsx src/scoring/verifyChallengesBatch3.ts",
    "test:frontend": "tsx src/scoring/verifyFrontend.ts",
    "test:hardening": "tsx src/verifyHardening.ts",
    "test:load": "tsx ../infra/loadtest/simulate-load.ts",
    "test:all": "tsx src/auth/verifyAuth.ts && tsx src/scoring/verifyScoring.ts && tsx src/admin/verifyAdmin.ts && tsx src/scoring/verifyChallengesBatch1.ts && tsx src/scoring/verifyChallengesBatch2.ts && tsx src/scoring/verifyChallengesBatch3.ts && tsx src/scoring/verifyFrontend.ts && tsx src/verifyHardening.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:backup-test": "tsx src/db/backupRestoreTest.ts",
    "admin:export": "tsx src/admin/exportResults.ts",
    "admin:break-glass": "tsx src/admin/breakGlass.ts",
    "test:guards": "tsx src/auth/verifyRegistrationGuards.ts",
    "test:origin": "tsx src/middleware/verifyPlatformOrigin.ts",
    "db:backup": "tsx src/db/backup.ts"
  },
  "dependencies": {
    "@sentry/node": "^11.12.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.11",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
