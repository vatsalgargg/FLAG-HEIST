# Next.js proxies API requests to the separate scoring service.
CTF_API_URL=http://127.0.0.1:8180
# Used by docker compose. These are LOCAL examples, not production credentials.
PLATFORM_ORIGIN=http://localhost:3000
JWT_SECRET=local-team-key-change-before-production-0001
ADMIN_JWT_SECRET=local-admin-key-change-before-production-0002
RESET_TOKEN=local-reset-key-change-before-production-0003
FLAG_PEPPER=local-flag-pepper-change-before-production-0004
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=local-organiser-password
SENTRY_DSN=
ALERT_WEBHOOK_URL=
CTF_NODE_ENV=development

# For running the scoring API directly (Compose sets its own persistent path).
SQLITE_PATH=./data/flagheist.db
REDIS_URL=redis://127.0.0.1:6379
